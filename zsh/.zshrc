# p10k instant prompt — keep at the very top
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)
source $ZSH/oh-my-zsh.sh

# History (after Oh My Zsh so these values win)
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt share_history          # commands become available in your other open terminals
setopt hist_ignore_all_dups   # drop older copies of repeated commands
setopt hist_ignore_space      # a command typed with a leading space isn't saved

# p10k settings (generated by `p10k configure`)
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

export FZF_CTRL_T_OPTS="--preview 'bat --color=always --line-range=:200 {}'"
source <(fzf --zsh)
eval "$(zoxide init zsh)"

alias ls="eza --icons --group-directories-first"
alias ll="eza -l --icons --group-directories-first"
alias la="eza -la --icons --group-directories-first"
alias lt="eza --tree --level=2 --icons"